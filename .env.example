# ============================================================
# +Pedido — Exemplo de variáveis de ambiente
# Copie para .env.local e preencha com os dados REAIS do seu
# projeto Supabase (Dashboard > Project Settings > API).
# NUNCA commite chaves reais: .env.local e .env* ficam no
# .gitignore. Apenas .env.example é versionado.
# ============================================================

# URL do projeto Supabase (ex.: https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública "anon" do Supabase (pode ficar exposta no front-end)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
